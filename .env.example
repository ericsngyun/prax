# Vercel Blob (asset storage) — required for `pnpm add-asset`
BLOB_READ_WRITE_TOKEN=

# Pull these from Vercel automatically with:
#   vercel env pull .env.local --environment=development

# Meta (Facebook) Pixel — Events Manager → Data Sources → your dataset ID.
# 15–16 digit number. Leave blank locally: with no ID the pixel renders nothing
# and fires no events, so dev and preview traffic stay out of Ads Manager.
# Set this in Vercel for the Production environment only.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API — server-only, never exposed to the browser.
# System User access token from Events Manager. Set in Vercel only; do not
# put a real value in this file or any file that is committed.
META_CAPI_ACCESS_TOKEN=

# Meta Test Events code. Ignored when VERCEL_ENV=production, so it can never
# divert live conversions into the test view. Set on Preview for QA.
META_TEST_EVENT_CODE=
